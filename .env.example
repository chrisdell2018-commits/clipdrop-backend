# ─── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database (PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/clipdrop

# ─── Redis (job queue) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this

# ─── File Storage (AWS S3 or Cloudflare R2) ───────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET=clipdrop-videos

# ─── YouTube ──────────────────────────────────────────
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:4000/auth/youtube/callback

# ─── TikTok ───────────────────────────────────────────
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:4000/auth/tiktok/callback

# ─── Meta (Instagram + Facebook) ─────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:4000/auth/meta/callback

# ─── App URL (frontend) ───────────────────────────────
FRONTEND_URL=http://localhost:3000
